{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reachwhy corpus expected verdict",
  "description": "Veredicto esperado de un caso del corpus. Version de esquema semver.",
  "type": "object",
  "required": ["schemaVersion", "caseId", "minRulesetVersion", "source", "pair", "expected", "reviewedBy"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "caseId": { "type": "string", "minLength": 1, "description": "Igual al nombre de carpeta y a snapshot.id." },
    "minRulesetVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source": { "$ref": "#/$defs/source" },
    "pair": {
      "type": "object",
      "required": ["origin", "target"],
      "properties": {
        "origin": { "type": "string" },
        "target": { "type": "string" },
        "targetSubresource": { "type": "string" }
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "required": ["overall", "hops"],
      "properties": {
        "overall": { "enum": ["green", "amber", "red"] },
        "firstRedHop": { "type": ["string", "null"] },
        "hops": {
          "type": "object",
          "description": "Solo se afirma lo que importa; any = no se afirma.",
          "additionalProperties": {
            "type": "object",
            "required": ["state"],
            "properties": {
              "state": { "enum": ["green", "amber", "red", "any"] },
              "code": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "mustNotBeGreen": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "reviewedBy": { "type": "string", "description": "Persona que comparo el esperado con la fuente; un caso sin revision humana no se marca como oficial." },
    "notes": { "type": "string" }
  },
  "patternProperties": { "^x-": {} },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["type", "license"],
      "properties": {
        "type": { "enum": ["official-troubleshooting", "official-architecture", "community-qa", "synthetic"] },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "section": { "type": "string" },
        "readOn": { "type": "string", "description": "Fecha de lectura (AAAA-MM-DD) o vacio si aun no se leyo." },
        "license": {
          "type": "object",
          "required": ["mode", "quote"],
          "properties": {
            "mode": { "enum": ["reconstructed-own-data", "quoted-short"] },
            "quote": { "type": "boolean" },
            "spdx": { "type": ["string", "null"] },
            "evidence": { "type": ["string", "null"], "description": "Enlace a la pagina de licencia revisada." },
            "checkedOn": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "synthetic" } } }, "then": {}, "else": { "required": ["url"] } }
      ],
      "additionalProperties": false
    }
  }
}
